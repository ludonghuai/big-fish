{
  "name": "bigfish",
  "version": "0.0.1",
  "description": "Bigfish — Electron desktop shell for DeepSeek Harness",
  "private": true,
  "main": "main.js",
  "author": {
    "name": "Bigfish",
    "email": "643820309@qq.com"
  },
  "homepage": "https://gitee.com/ludonghuai/big-fish",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/ensure-deps.js --bundle-only",
    "prestart": "node scripts/ensure-deps.js",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "icons": "node make-icons.js",
    "make-latest": "node make-latest.js",
    "bundle:refresh": "node scripts/refresh-dsh-bundle.js",
    "bundle:check": "node scripts/refresh-dsh-bundle.js --check",
    "lint": "node scripts/gates/run.js",
    "test": "node scripts/test-run.js",
    "test:full": "node scripts/test-run.js --full",
    "test:integration": "node scripts/test-integration.js"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bigfish.app",
    "productName": "Bigfish",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "npmRebuild": false,
    "afterPack": "afterPack.js",
    "files": [
      "main.js",
      "shell-settings.js",
      "shell-assets.js",
      "shell-notify.js",
      "shell-backend.js",
      "shell-pet-geometry.js",
      "shell-pet-drag.js",
      "shell-pet.js",
      "pet-physics-core.js",
      "shell-pet-physics.js",
      "pet-work-core.js",
      "shell-pet-work.js",
      "affinity-core.js",
      "shell-affinity.js",
      "shell-mode.js",
      "shell-plugins.js",
      "shell-window.js",
      "shell-market.js",
      "shell-tray.js",
      "shell-update.js",
      "shell-ipc.js",
      "pet.html",
      "pet.js",
      "pet-chain-core.js",
      "pet-chain.js",
      "pet-preload.js",
      "market.html",
      "market.js",
      "market-update.js",
      "market-preload.js",
      "update.html",
      "update.js",
      "update-preload.js",
      "updater.js",
      "update-lib.js",
      "harness-store.js",
      "exchange.html",
      "exchange.js",
      "exchange-preload.js",
      "plugins.json",
      "bundled-skills/**/*",
      "assets/**/*",
      "build/icon.png",
      "build/icon.ico",
      "build/tray.png",
      "THIRD-PARTY-NOTICES.md",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "node-runtime",
        "to": "node-runtime"
      },
      {
        "from": "bundled-plugins",
        "to": "bundled-plugins"
      },
      {
        "from": "dsh-bundle/node_modules",
        "to": "dsh/node_modules"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}.Setup.${version}.${ext}",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "shortcutName": "Bigfish"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    }
  }
}
